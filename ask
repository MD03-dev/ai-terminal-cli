#!/data/data/com.termux/files/usr/bin/bash
# AI Terminal CLI - ask

if [ -z "$AI_API_KEY" ]; then
  echo "❌ Lỗi: Chưa cài đặt AI_API_KEY."
  echo "👉 Chạy lệnh: export AI_API_KEY='key_cua_ban'"
  exit 1
fi

if [ -z "$1" ]; then
  echo "Cách dùng: ask \"câu hỏi của bạn\""
  exit 1
fi

PROMPT="$*"
echo "🤖 AI đang suy nghĩ..."

JSON_PAYLOAD=$(jq -n --arg msg "$PROMPT" '{
  model: "llama3-8b-8192",
  messages: [{role: "user", content: $msg}]
}')

RESPONSE=$(curl -s -X POST "https://api.groq.com/openai/v1/chat/completions" \
  -H "Authorization: Bearer $AI_API_KEY" \
  -H "Content-Type: application/json" \
  -d "$JSON_PAYLOAD")

echo "$RESPONSE" | jq -r '.choices[0].message.content' 2>/dev/null || echo "❌ Có lỗi xảy ra. Kiểm tra lại API Key hoặc mạng."
